<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="radwan_salary_structure_type" model="hr.payroll.structure.type">
        <field name="name">Radwan Payroll</field>
        <field name="country_id" eval="False"/>
    </record>

    <record id="radwan_rule_basic" model="hr.salary.rule">
        <field name="name">Basic</field>
        <field name="sequence" eval="10"/>
        <field name="code">BASIC</field>
        <field name="category_id" ref="om_hr_payroll.BASIC"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = contract.wage</field>
    </record>

    <record id="radwan_rule_housing" model="hr.salary.rule">
        <field name="name">Housing</field>
        <field name="sequence" eval="20"/>
        <field name="code">HOUSING</field>
        <field name="category_id" ref="om_hr_payroll.ALW"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = contract.radwan_housing</field>
    </record>

    <record id="radwan_rule_transportation" model="hr.salary.rule">
        <field name="name">Transportation</field>
        <field name="sequence" eval="30"/>
        <field name="code">TRANSPORT</field>
        <field name="category_id" ref="om_hr_payroll.ALW"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = contract.radwan_transportation</field>
    </record>

    <record id="radwan_rule_fuel_car_allowance" model="hr.salary.rule">
        <field name="name">Fuel and Car Allowance</field>
        <field name="sequence" eval="40"/>
        <field name="code">FUELCAR</field>
        <field name="category_id" ref="om_hr_payroll.ALW"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = contract.radwan_fuel_car_allowance</field>
    </record>

    <record id="radwan_rule_mobile_communications_allowance" model="hr.salary.rule">
        <field name="name">Mobile and Communications Allowance</field>
        <field name="sequence" eval="50"/>
        <field name="code">MOBILE</field>
        <field name="category_id" ref="om_hr_payroll.ALW"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = contract.radwan_mobile_communications_allowance</field>
    </record>

    <record id="radwan_rule_other_allowances" model="hr.salary.rule">
        <field name="name">Other Allowances</field>
        <field name="sequence" eval="60"/>
        <field name="code">OTHERALW</field>
        <field name="category_id" ref="om_hr_payroll.ALW"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = contract.radwan_other_allowances</field>
    </record>

    <record id="radwan_rule_gross" model="hr.salary.rule">
        <field name="name">Gross</field>
        <field name="sequence" eval="100"/>
        <field name="code">GROSS</field>
        <field name="category_id" ref="om_hr_payroll.GROSS"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
    </record>

    <record id="radwan_rule_net" model="hr.salary.rule">
        <field name="name">Net Salary</field>
        <field name="sequence" eval="200"/>
        <field name="code">NET</field>
        <field name="category_id" ref="om_hr_payroll.NET"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories.BASIC + categories.ALW + categories.DED</field>
        <field name="register_id" ref="om_hr_payroll.contrib_register_employees"/>
    </record>

    <record id="radwan_salary_structure" model="hr.payroll.structure">
        <field name="name">Radwan Salary Structure</field>
        <field name="code">RADWAN</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="parent_id" eval="False"/>
        <field name="radwan_structure_type_id" ref="radwan_salary_structure_type"/>
        <field name="rule_ids" eval="[
            (6, 0, [
                ref('radwan_rule_basic'),
                ref('radwan_rule_housing'),
                ref('radwan_rule_transportation'),
                ref('radwan_rule_fuel_car_allowance'),
                ref('radwan_rule_mobile_communications_allowance'),
                ref('radwan_rule_other_allowances'),
                ref('radwan_rule_gross'),
                ref('radwan_rule_net')
            ])
        ]"/>
    </record>
</odoo>
