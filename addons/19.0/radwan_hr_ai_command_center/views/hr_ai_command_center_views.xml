<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_ai_command_center_list" model="ir.ui.view">
        <field name="name">radwan.hr.ai.command.center.list</field>
        <field name="model">radwan.hr.ai.command.center</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="employee_count"/>
                <field name="attendance_count"/>
                <field name="leave_count"/>
                <field name="loan_count"/>
                <field name="ticket_count"/>
            </list>
        </field>
    </record>

    <record id="view_hr_ai_command_center_form" model="ir.ui.view">
        <field name="name">radwan.hr.ai.command.center.form</field>
        <field name="model">radwan.hr.ai.command.center</field>
        <field name="arch" type="xml">
            <form string="HR AI Command Center">
                <header>
                    <button name="action_refresh_insights" type="object" string="Refresh Insights" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Secure Metrics">
                        <field name="employee_count"/>
                        <field name="attendance_count"/>
                        <field name="leave_count"/>
                        <field name="payslip_count"/>
                        <field name="loan_count"/>
                        <field name="ticket_count"/>
                    </group>
                    <field name="insight_ids" readonly="1">
                        <list>
                            <field name="severity"/>
                            <field name="insight_type"/>
                            <field name="name"/>
                            <field name="source_model"/>
                            <field name="source_count"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_ai_insight_list" model="ir.ui.view">
        <field name="name">radwan.hr.ai.insight.list</field>
        <field name="model">radwan.hr.ai.insight</field>
        <field name="arch" type="xml">
            <list>
                <field name="severity"/>
                <field name="insight_type"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="source_model"/>
                <field name="source_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_ai_insight_form" model="ir.ui.view">
        <field name="name">radwan.hr.ai.insight.form</field>
        <field name="model">radwan.hr.ai.insight</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_reviewed" type="object" string="Mark Reviewed" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_dismiss" type="object" string="Dismiss" invisible="state == 'dismissed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="severity"/>
                        <field name="insight_type"/>
                        <field name="employee_id"/>
                        <field name="department_id"/>
                        <field name="source_model"/>
                        <field name="source_count"/>
                    </group>
                    <group>
                        <field name="summary"/>
                        <field name="recommendation"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_ai_command_center" model="ir.actions.act_window">
        <field name="name">HR AI Command Center</field>
        <field name="res_model">radwan.hr.ai.command.center</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_ai_insights" model="ir.actions.act_window">
        <field name="name">HR AI Insights</field>
        <field name="res_model">radwan.hr.ai.insight</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
