<odoo>
    <template id="report_hr_loan_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="loan">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Employee Loan</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Reference:</strong>
                                <span t-field="loan.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong>
                                <span t-field="loan.state"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <strong>Employee:</strong>
                                <span t-field="loan.employee_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Company:</strong>
                                <span t-field="loan.company_id"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-4">
                                <strong>Loan Date:</strong>
                                <span t-field="loan.loan_date"/>
                            </div>
                            <div class="col-4">
                                <strong>Start Date:</strong>
                                <span t-field="loan.start_date"/>
                            </div>
                            <div class="col-4">
                                <strong>End Date:</strong>
                                <span t-field="loan.end_date"/>
                            </div>
                        </div>
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Loan Amount</th>
                                    <th>Paid</th>
                                    <th>Balance</th>
                                    <th>Installments</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="loan.loan_amount"/></td>
                                    <td><span t-field="loan.paid_amount"/></td>
                                    <td><span t-field="loan.balance_amount"/></td>
                                    <td><span t-field="loan.installment_count"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h4 class="mt-4">Installments</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Paid</th>
                                    <th class="text-end">Balance</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="loan.installment_ids" t-as="line">
                                    <td><span t-field="line.date"/></td>
                                    <td class="text-end"><span t-field="line.amount"/></td>
                                    <td class="text-end"><span t-field="line.paid_amount"/></td>
                                    <td class="text-end"><span t-field="line.balance_amount"/></td>
                                    <td><span t-field="line.state"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="mt-4" t-if="loan.reason">
                            <strong>Reason</strong>
                            <p t-field="loan.reason"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
