<odoo>
    <record id="hr_loan_payment_method_view_list" model="ir.ui.view">
        <field name="name">hr.loan.payment.method.view.list</field>
        <field name="model">hr.loan.payment.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="journal_id"/>
                <field name="loan_account_id"/>
                <field name="disbursement_account_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="hr_loan_payment_method_view_form" model="ir.ui.view">
        <field name="name">hr.loan.payment.method.view.form</field>
        <field name="model">hr.loan.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="analytic_account_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Accounting">
                            <field name="loan_account_id"/>
                            <field name="disbursement_account_id"/>
                            <field name="payroll_debit_account_id"/>
                            <field name="payroll_credit_account_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_loan_payment_method_action" model="ir.actions.act_window">
        <field name="name">Loan Payment Methods</field>
        <field name="res_model">hr.loan.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
