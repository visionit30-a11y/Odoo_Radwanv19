<odoo>
    <record id="radwan_approval_request_rule_company" model="ir.rule">
        <field name="name">radwan.approval.request.rule.company</field>
        <field name="model_id" ref="model_radwan_approval_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="radwan_approval_request_rule_user" model="ir.rule">
        <field name="name">radwan.approval.request.rule.user</field>
        <field name="model_id" ref="model_radwan_approval_request"/>
        <field name="domain_force">['|', ('request_owner_id', '=', user.id), ('approver_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('radwan_approvals_group_user'))]"/>
    </record>

    <record id="radwan_approval_request_rule_manager" model="ir.rule">
        <field name="name">radwan.approval.request.rule.manager</field>
        <field name="model_id" ref="model_radwan_approval_request"/>
