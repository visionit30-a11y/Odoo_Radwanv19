<odoo>
    <record id="approval_product_line_view_list" model="ir.ui.view">
        <field name="name">radwan.approval.product.line.view.list</field>
        <field name="model">radwan.approval.product.line</field>
        <field name="arch" type="xml">
            <list string="Approval Products">
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="price_unit"/>
                <field name="subtotal"/>
            </list>
        </field>
    </record>

    <record id="approval_product_line_view_form" model="ir.ui.view">
        <field name="name">radwan.approval.product.line.view.form</field>
        <field name="model">radwan.approval.product.line</field>
        <field name="arch" type="xml">
            <form string="Approval Product">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="product_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                            <field name="price_unit"/>
                            <field name="subtotal" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="approval_product_template_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_is_storable': True}</field>
    </record>

    <record id="approval_product_variant_action" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
