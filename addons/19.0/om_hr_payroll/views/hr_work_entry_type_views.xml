<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="radwan_hr_work_entry_type_view_form" model="ir.ui.view">
        <field name="name">radwan.hr.work.entry.type.form</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='time_off']" position="inside">
                <field name="is_leave"/>
            </xpath>

            <xpath expr="//group[@name='other']" position="inside">
                <group name="radwan_display_in_payslip" string="Display in Payslip" class="o_form_fw_labels">
                    <field name="radwan_display_in_payslip"/>
                    <field name="radwan_rounding"/>
                </group>
                <group name="radwan_unpaid" string="Unpaid" class="o_form_fw_labels">
                    <field name="radwan_unpaid_structure_type_ids" widget="many2many_tags"/>
                    <field name="is_work"/>
                </group>
                <group name="radwan_reporting" string="Reporting" class="o_form_fw_labels">
                    <field name="radwan_unforeseen_absence"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
