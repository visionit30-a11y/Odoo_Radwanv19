<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appraisal_type_list" model="ir.ui.view">
        <field name="name">radwan.appraisal.type.list</field>
        <field name="model">radwan.appraisal.type</field>
        <field name="arch" type="xml">
            <list string="أنواع التقييم">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="frequency"/>
                <field name="color" widget="color_picker"/>
                <field name="appraisal_count" string="التقييمات"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_appraisal_type_form" model="ir.ui.view">
        <field name="name">radwan.appraisal.type.form</field>
        <field name="model">radwan.appraisal.type</field>
        <field name="arch" type="xml">
            <form string="نوع التقييم">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appraisals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list-alt">
                            <field name="appraisal_count" widget="statinfo" string="تقييم"/>
                        </button>
                    </div>
                    <group>
                        <group string="معلومات النوع">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="frequency"/>
                        </group>
                        <group string="الإعدادات">
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="الوصف">
                        <field name="description" nolabel="1"
                               placeholder="وصف هذا النوع من التقييمات وهدفه..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_appraisal_type" model="ir.actions.act_window">
        <field name="name">أنواع التقييم</field>
        <field name="res_model">radwan.appraisal.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
