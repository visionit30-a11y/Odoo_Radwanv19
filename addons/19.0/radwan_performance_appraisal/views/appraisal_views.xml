<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════ -->
    <!--              FORM VIEW - نموذج التقييم              -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_appraisal_form" model="ir.ui.view">
        <field name="name">radwan.appraisal.form</field>
        <field name="model">radwan.appraisal</field>
        <field name="arch" type="xml">
            <form string="تقييم الأداء">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="تأكيد التقييم"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_self_review"
                            type="object"
                            string="بدء التقييم الذاتي"
                            class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="action_manager_review"
                            type="object"
                            string="إرسال لمراجعة المدير"
                            class="oe_highlight"
                            invisible="state != 'self_review'"/>
                    <button name="action_hr_review"
                            type="object"
                            string="إرسال للموارد البشرية"
                            class="oe_highlight"
                            invisible="state != 'manager_review'"/>
                    <button name="action_done"
                            type="object"
                            string="إتمام التقييم ✓"
                            class="oe_highlight"
                            invisible="state != 'hr_review'"/>
                    <button name="action_cancel"
                            type="object"
                            string="إلغاء"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft"
                            type="object"
                            string="إعادة للمسودة"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,self_review,manager_review,hr_review,done"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employee_appraisals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="not employee_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">تقييمات سابقة</span>
                            </div>
                        </button>
                        <button type="object" name="action_view_employee_appraisals"
                                class="oe_stat_button"
                                icon="fa-star"
                                invisible="not rating_id or state not in ('hr_review', 'done')">
                            <div class="o_stat_info">
                                <field name="rating_id"/>
                            </div>
                        </button>
                    </div>

                    <!-- Title Bar -->
                    <div class="oe_title">
                        <label for="name" string="رقم التقييم"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="priority" widget="priority"/>
                    </div>

                    <!-- Main Info -->
                    <group>
                        <group string="بيانات الموظف">
                            <field name="employee_id"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="reviewer_id"/>
                        </group>
                        <group string="بيانات التقييم">
                            <field name="period_id"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="type_id" readonly="1"/>
                            <field name="template_id"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="hr_reviewer_id"/>
                        </group>
                    </group>

                    <!-- Load Template Button -->
                    <div invisible="state not in ('draft', 'confirmed') or not template_id">
                        <button name="action_load_template"
                                type="object"
                                string="تحميل معايير القالب"
                                class="btn btn-secondary btn-sm"
                                icon="fa-download"/>
                        <span class="text-muted small ms-2">
                            سيتم استبدال البنود الحالية بمعايير القالب المختار
                        </span>
                    </div>

                    <notebook>
                        <!-- TAB 1: Appraisal Lines -->
                        <page string="بنود التقييم" name="appraisal_lines">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="weighted_manager_score &gt;= (weight * 0.9)"
                                      decoration-warning="weighted_manager_score &gt;= (weight * 0.6) and weighted_manager_score &lt; (weight * 0.9) and weighted_manager_score &gt; 0"
                                      decoration-danger="weighted_manager_score &lt; (weight * 0.6) and weighted_manager_score &gt; 0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="criteria_id" required="True"/>
                                    <field name="category" optional="show"/>
                                    <field name="weight" string="الوزن %"
                                           sum="إجمالي الأوزان"/>
                                    <field name="self_score"
                                           string="الذاتي"
                                           readonly="parent.state not in ('self_review')"/>
                                    <field name="weighted_self_score"
                                           string="الذاتي الموزون"
                                           optional="show"
                                           sum="إجمالي الذاتي"/>
                                    <field name="manager_score"
                                           string="المدير"
                                           readonly="parent.state not in ('manager_review', 'hr_review')"/>
                                    <field name="weighted_manager_score"
                                           string="المدير الموزون"
                                           optional="show"
                                           sum="إجمالي المدير"/>
                                    <field name="comment" string="التغذية الراجعة" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 2: Score Summary -->
                        <page string="ملخص الدرجات" name="score_summary">
                            <group>
                                <group string="نتائج التقييم">
                                    <field name="self_score"
                                           string="الدرجة الذاتية %"
                                           readonly="1"
                                           widget="float"/>
                                    <field name="manager_score"
                                           string="درجة المدير %"
                                           readonly="1"
                                           widget="float"/>
                                    <field name="total_score"
                                           string="الدرجة الإجمالية %"
                                           readonly="1"
                                           widget="float"/>
                                </group>
                                <group string="التقدير النهائي">
                                    <field name="rating_id" readonly="1"/>
                                    <field name="date_open"/>
                                    <field name="date_close" readonly="1"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 3: Notes -->
                        <page string="الملاحظات والتوصيات" name="notes">
                            <field name="notes"
                                   nolabel="1"
                                   placeholder="أدخل ملاحظاتك وتوصياتك بشأن هذا التقييم..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!--              LIST VIEW - قائمة التقييمات            -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_appraisal_list" model="ir.ui.view">
        <field name="name">radwan.appraisal.list</field>
        <field name="model">radwan.appraisal</field>
        <field name="arch" type="xml">
            <list string="تقييمات الأداء"
                  decoration-success="state == 'done'"
                  decoration-info="state in ('confirmed', 'self_review')"
                  decoration-warning="state in ('manager_review', 'hr_review')"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="الرقم"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="period_id"/>
                <field name="type_id" optional="show"/>
                <field name="reviewer_id" optional="show"/>
                <field name="date_open"/>
                <field name="total_score" string="الدرجة %"
                       decoration-success="total_score &gt;= 90"
                       decoration-warning="total_score &gt;= 60 and total_score &lt; 80"
                       decoration-danger="total_score &gt; 0 and total_score &lt; 60"
                       optional="show"/>
                <field name="rating_id" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('confirmed', 'self_review')"
                       decoration-warning="state in ('manager_review', 'hr_review')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!--             KANBAN VIEW - لوحة كانبان               -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_appraisal_kanban" model="ir.ui.view">
        <field name="name">radwan.appraisal.kanban</field>
        <field name="model">radwan.appraisal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column"
                    group_create="false">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="period_id"/>
                <field name="type_id"/>
                <field name="state"/>
                <field name="total_score"/>
                <field name="rating_id"/>
                <field name="priority"/>
                <field name="color"/>
                <field name="date_open"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value}">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="employee_id"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="name"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_manage_toggle_button">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <span class="text-muted">
                                            <i class="fa fa-calendar"/> <field name="period_id"/>
                                        </span>
                                    </div>
                                    <div invisible="not department_id">
                                        <span class="text-muted">
                                            <i class="fa fa-building"/> <field name="department_id"/>
                                        </span>
                                    </div>
                                    <div invisible="not type_id">
                                        <span class="badge bg-secondary">
                                            <field name="type_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <t t-if="record.total_score.raw_value &gt; 0">
                                            <span t-attf-class="badge #{record.total_score.raw_value &gt;= 90 ? 'text-bg-success' : record.total_score.raw_value &gt;= 70 ? 'text-bg-primary' : record.total_score.raw_value &gt;= 60 ? 'text-bg-warning' : 'text-bg-danger'}">
                                                <field name="total_score"/>%
                                            </span>
                                        </t>
                                        <t t-if="record.rating_id.raw_value">
                                            <span class="ms-1 text-muted small">
                                                <field name="rating_id"/>
                                            </span>
                                        </t>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-attf-class="badge #{record.state.raw_value == 'done' ? 'text-bg-success' : ['manager_review', 'hr_review'].includes(record.state.raw_value) ? 'text-bg-warning' : record.state.raw_value == 'cancelled' ? 'text-bg-danger' : 'text-bg-secondary'}">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!--             SEARCH VIEW - بحث وتصفية                -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_appraisal_search" model="ir.ui.view">
        <field name="name">radwan.appraisal.search</field>
        <field name="model">radwan.appraisal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="department_id"/>
                <field name="type_id"/>
                <field name="reviewer_id"/>
                <filter name="my_appraisals" string="تقييماتي" domain="[('reviewer_id.user_id', '=', uid)]"/>
                <filter name="state_draft" string="مسودة" domain="[('state', '=', 'draft')]"/>
                <filter name="state_confirmed" string="مؤكد" domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_self" string="تقييم ذاتي" domain="[('state', '=', 'self_review')]"/>
                <filter name="state_manager" string="مراجعة المدير" domain="[('state', '=', 'manager_review')]"/>
                <filter name="state_hr" string="مراجعة الموارد البشرية" domain="[('state', '=', 'hr_review')]"/>
                <filter name="state_done" string="مكتملة" domain="[('state', '=', 'done')]"/>
                <filter name="state_cancelled" string="ملغاة" domain="[('state', '=', 'cancelled')]"/>
                <filter name="in_progress" string="قيد التنفيذ" domain="[('state', 'not in', ['done', 'cancelled'])]"/>
                <filter name="high_score" string="درجة ممتازة (90%+)" domain="[('total_score', '&gt;=', 90)]"/>
                <filter name="low_score" string="درجة ضعيفة (أقل من 60%)" domain="[('total_score', '&gt;', 0), ('total_score', '&lt;', 60)]"/>
                <separator/>
                <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                <filter name="group_period" string="الفترة" context="{'group_by': 'period_id'}"/>
                <filter name="group_type" string="نوع التقييم" context="{'group_by': 'type_id'}"/>
                <filter name="group_department" string="القسم" context="{'group_by': 'department_id'}"/>
                <filter name="group_employee" string="الموظف" context="{'group_by': 'employee_id'}"/>
                <filter name="group_rating" string="التقدير" context="{'group_by': 'rating_id'}"/>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!--              ACTIONS - إجراءات النوافذ              -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="action_appraisal" model="ir.actions.act_window">
        <field name="name">تقييمات الأداء</field>
        <field name="res_model">radwan.appraisal</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_appraisal_search"/>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا يوجد تقييمات حتى الآن
            </p>
            <p>أنشئ أول تقييم أداء بالنقر على زر "جديد"</p>
        </field>
    </record>

    <record id="action_appraisal_all" model="ir.actions.act_window">
        <field name="name">جميع التقييمات</field>
        <field name="res_model">radwan.appraisal</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_appraisal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا يوجد تقييمات بعد
            </p>
        </field>
    </record>

    <record id="action_appraisal_done" model="ir.actions.act_window">
        <field name="name">التقييمات المكتملة</field>
        <field name="res_model">radwan.appraisal</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="search_view_id" ref="view_appraisal_search"/>
    </record>

</odoo>
