<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="menu_radwan_appraisal_root" model="ir.ui.menu">
        <field name="name">التقييم</field>
        <field name="parent_id" eval="False"/>
        <field name="sequence" eval="55"/>
        <field name="group_ids" eval="[(4, ref('radwan_performance_appraisal.group_appraisal_user'))]"/>
    </record>

    <menuitem id="menu_appraisal_main"
              name="Appraisals"
              parent="menu_radwan_appraisal_root"
              sequence="10"/>

    <menuitem id="menu_appraisal_all"
              name="All Appraisals"
              parent="menu_appraisal_main"
              action="action_appraisal_all"
              sequence="10"
              groups="radwan_performance_appraisal.group_appraisal_manager"/>

    <menuitem id="menu_appraisal_inprogress"
              name="In Progress Appraisals"
              parent="menu_appraisal_main"
              action="action_appraisal"
              sequence="20"/>

    <menuitem id="menu_appraisal_done"
              name="Completed Appraisals"
              parent="menu_appraisal_main"
              action="action_appraisal_done"
              sequence="30"/>

    <menuitem id="menu_appraisal_periods_root"
              name="Periods"
              parent="menu_radwan_appraisal_root"
              sequence="20"
              groups="radwan_performance_appraisal.group_appraisal_manager"/>

    <menuitem id="menu_appraisal_periods"
              name="Appraisal Periods"
              parent="menu_appraisal_periods_root"
              action="action_appraisal_period"
              sequence="10"/>

    <menuitem id="menu_appraisal_config"
              name="Configuration"
              parent="menu_radwan_appraisal_root"
              sequence="100"
              groups="radwan_performance_appraisal.group_appraisal_manager"/>

    <menuitem id="menu_appraisal_types"
              name="Appraisal Types"
              parent="menu_appraisal_config"
              action="action_appraisal_type"
              sequence="10"/>

    <menuitem id="menu_appraisal_templates"
              name="Appraisal Templates"
              parent="menu_appraisal_config"
              action="action_appraisal_template"
              sequence="20"/>

    <menuitem id="menu_appraisal_criteria"
              name="Appraisal Criteria"
              parent="menu_appraisal_config"
              action="action_appraisal_criteria"
              sequence="30"/>

    <menuitem id="menu_appraisal_ratings"
              name="Rating Scales"
              parent="menu_appraisal_config"
              action="action_appraisal_rating"
              sequence="40"/>

</odoo>
