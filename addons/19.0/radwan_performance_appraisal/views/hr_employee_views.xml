<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_radwan_appraisal" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.radwan.appraisal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_radwan_appraisals"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-star"
                    groups="radwan_performance_appraisal.group_appraisal_user"
                >
                    <field name="appraisal_count" widget="statinfo" string="Appraisals"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
