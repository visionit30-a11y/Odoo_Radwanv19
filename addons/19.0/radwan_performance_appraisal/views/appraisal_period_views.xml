<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appraisal_period_list" model="ir.ui.view">
        <field name="name">radwan.appraisal.period.list</field>
        <field name="model">radwan.appraisal.period</field>
        <field name="arch" type="xml">
            <list string="فترات التقييم"
                  decoration-success="state == 'open'"
                  decoration-muted="state == 'closed'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="type_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'open'"
                       decoration-muted="state == 'closed'"/>
                <field name="appraisal_count" string="التقييمات"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_appraisal_period_form" model="ir.ui.view">
        <field name="name">radwan.appraisal.period.form</field>
        <field name="model">radwan.appraisal.period</field>
        <field name="arch" type="xml">
            <form string="فترة التقييم">
                <header>
                    <button name="action_open" type="object" string="فتح الفترة"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="إغلاق الفترة"
                            invisible="state != 'open'"/>
                    <button name="action_reset_draft" type="object" string="إعادة للمسودة"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appraisals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users"
                                invisible="appraisal_count == 0">
                            <field name="appraisal_count" widget="statinfo" string="تقييم"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="اسم الفترة (مثال: التقييم السنوي 2025)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="معلومات الفترة">
                            <field name="type_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="التواريخ">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="ملاحظات">
                        <field name="notes" nolabel="1"
                               placeholder="ملاحظات وتعليمات خاصة بهذه الفترة..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_appraisal_period_search" model="ir.ui.view">
        <field name="name">radwan.appraisal.period.search</field>
        <field name="model">radwan.appraisal.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <filter name="filter_open" string="مفتوحة" domain="[('state', '=', 'open')]"/>
                <filter name="filter_draft" string="مسودة" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_closed" string="مغلقة" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="group_type" string="النوع" context="{'group_by': 'type_id'}"/>
                <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_appraisal_period" model="ir.actions.act_window">
        <field name="name">فترات التقييم</field>
        <field name="res_model">radwan.appraisal.period</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_appraisal_period_search"/>
    </record>

</odoo>
