<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appraisal_template_list" model="ir.ui.view">
        <field name="name">radwan.appraisal.template.list</field>
        <field name="model">radwan.appraisal.template</field>
        <field name="arch" type="xml">
            <list string="قوالب التقييم">
                <field name="name"/>
                <field name="type_id"/>
                <field name="criteria_count" string="المعايير"/>
                <field name="total_weight" string="إجمالي الأوزان %"
                       decoration-danger="total_weight &lt; 99.9 or total_weight &gt; 100.1"
                       decoration-success="total_weight &gt;= 99.9 and total_weight &lt;= 100.1"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_appraisal_template_form" model="ir.ui.view">
        <field name="name">radwan.appraisal.template.form</field>
        <field name="model">radwan.appraisal.template</field>
        <field name="arch" type="xml">
            <form string="قالب التقييم">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="اسم القالب..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="criteria_count" string="عدد المعايير"/>
                            <field name="total_weight" string="إجمالي الأوزان %"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="معايير التقييم" name="criteria">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="criteria_id"/>
                                    <field name="category" optional="show"/>
                                    <field name="weight" string="الوزن %"
                                           sum="إجمالي الأوزان"/>
                                </list>
                            </field>
                            <div class="o_field_widget text-muted small mt-2">
                                <i class="fa fa-info-circle"/> يجب أن يكون مجموع الأوزان 100% لضمان دقة الحساب
                            </div>
                        </page>
                        <page string="الوصف" name="description">
                            <field name="description" nolabel="1"
                                   placeholder="وصف هذا القالب وحالات استخدامه..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_appraisal_template" model="ir.actions.act_window">
        <field name="name">قوالب التقييم</field>
        <field name="res_model">radwan.appraisal.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
