<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_appraisal_user" model="res.groups">
        <field name="name">Performance Appraisal / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_appraisal_manager" model="res.groups">
        <field name="name">Performance Appraisal / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_appraisal_user'))]"/>
    </record>

    <record id="hr.group_hr_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('radwan_performance_appraisal.group_appraisal_user'))]"/>
    </record>

    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('radwan_performance_appraisal.group_appraisal_manager'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('radwan_performance_appraisal.group_appraisal_manager'))]"/>
    </record>

</odoo>
