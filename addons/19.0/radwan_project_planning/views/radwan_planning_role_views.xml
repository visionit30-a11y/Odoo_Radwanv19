<odoo>
    <record id="radwan_planning_role_view_search" model="ir.ui.view">
        <field name="name">radwan.planning.role.view.search</field>
        <field name="model">radwan.planning.role</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_ids"/>
                <field name="project_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="radwan_planning_role_view_list" model="ir.ui.view">
        <field name="name">radwan.planning.role.view.list</field>
        <field name="model">radwan.planning.role</field>
        <field name="arch" type="xml">
            <list string="Roles">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="project_ids" widget="many2many_tags" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="radwan_planning_role_view_form" model="ir.ui.view">
        <field name="name">radwan.planning.role.view.form</field>
        <field name="model">radwan.planning.role</field>
        <field name="arch" type="xml">
            <form string="Planning Role">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_slots" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="slot_count" widget="statinfo" string="Shifts"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resources">
                            <field name="employee_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Projects">
                            <field name="project_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_radwan_planning_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">radwan.planning.role</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="radwan_planning_role_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create planning roles for employee and material scheduling.
            </p>
        </field>
    </record>
</odoo>
