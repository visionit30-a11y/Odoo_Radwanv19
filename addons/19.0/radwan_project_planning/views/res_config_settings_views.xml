<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.radwan.project.planning</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="58"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Planning" string="Planning" name="radwan_project_planning" logo="/project/static/description/icon.png" groups="project.group_project_manager">
                    <block title="Planning" name="radwan_planning_settings">
                        <setting id="radwan_planning_allow_unassignment" help="Let employees unassign themselves from their own planning shifts.">
                            <field name="radwan_planning_allow_unassignment"/>
                        </setting>
                        <setting id="radwan_planning_project_planning" help="Plan resource allocation across projects and tasks.">
                            <field name="radwan_planning_project_planning"/>
                        </setting>
                    </block>
                    <block title="Recurring Shifts" name="radwan_planning_recurring_settings">
                        <setting id="radwan_planning_recurring_months_ahead" help="Default planning horizon used by the Auto Plan wizard.">
                            <span>Generate shifts</span>
                            <field name="radwan_planning_recurring_months_ahead" class="oe_inline mx-2"/>
                            <span>months ahead</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_radwan_planning_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'radwan_project_planning', 'bin_size': False}</field>
    </record>
</odoo>
