<odoo>
    <record id="radwan_planning_material_view_search" model="ir.ui.view">
        <field name="name">radwan.planning.material.view.search</field>
        <field name="model">radwan.planning.material</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="role_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Default Role" name="group_default_role" context="{'group_by': 'default_role_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="radwan_planning_material_view_list" model="ir.ui.view">
        <field name="name">radwan.planning.material.view.list</field>
        <field name="model">radwan.planning.material</field>
        <field name="arch" type="xml">
            <list string="Materials">
                <field name="name"/>
                <field name="code"/>
                <field name="role_ids" widget="many2many_tags"/>
                <field name="default_role_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="calendar_id" optional="hide"/>
                <field name="hourly_cost" optional="hide"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="radwan_planning_material_view_form" model="ir.ui.view">
        <field name="name">radwan.planning.material.view.form</field>
        <field name="model">radwan.planning.material</field>
        <field name="arch" type="xml">
            <form string="Planning Material">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_slots" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="slot_count" widget="statinfo" string="Shifts"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="calendar_id"/>
                            <field name="hourly_cost"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Roles">
                        <field name="role_ids" widget="many2many_tags"/>
                        <field name="default_role_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_radwan_planning_material" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">radwan.planning.material</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="radwan_planning_material_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register equipment, rooms, vehicles, or any non-employee resource.
            </p>
        </field>
    </record>
</odoo>
