        <field name="model_id" ref="model_radwan_planning_material"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="radwan_planning_template_rule_company" model="ir.rule">
        <field name="name">Planning Template: Multi Company</field>
        <field name="model_id" ref="model_radwan_planning_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
</odoo>
