<odoo>
    <record id="group_radwan_planning_user" model="res.groups">
        <field name="name">Planning User</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user')), (4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
    </record>

    <record id="group_radwan_planning_manager" model="res.groups">
        <field name="name">Planning Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_radwan_planning_user')), (4, ref('project.group_project_manager')), (4, ref('hr_timesheet.group_timesheet_manager'))]"/>
    </record>
</odoo>
