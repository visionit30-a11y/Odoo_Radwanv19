<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="radwan_job_description_section_view_list" model="ir.ui.view">
        <field name="name">radwan.job.description.section.view.list</field>
        <field name="model">radwan.job.description.section</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="radwan_job_description_section_view_form" model="ir.ui.view">
        <field name="name">radwan.job.description.section.view.form</field>
        <field name="model">radwan.job.description.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="radwan_job_description_section_view_search" model="ir.ui.view">
        <field name="name">radwan.job.description.section.view.search</field>
        <field name="model">radwan.job.description.section</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="radwan_job_description_section_action" model="ir.actions.act_window">
        <field name="name">Job Description Headings</field>
        <field name="res_model">radwan.job.description.section</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem
        id="radwan_job_description_section_menu"
        name="Job Description Headings"
        parent="hr_recruitment.menu_hr_recruitment_config_jobs"
        action="radwan_job_description_section_action"
        sequence="30"
        groups="hr_recruitment.group_hr_recruitment_user"/>
</odoo>
