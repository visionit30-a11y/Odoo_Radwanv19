<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="radwan_hr_employee_expiry_monitoring_list_view" model="ir.ui.view">
        <field name="name">radwan.hr.employee.expiry.monitoring.list.inherit.profile.details</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="radwan_hr_employee_custom.radwan_hr_employee_expiry_monitoring_list_view"/>
        <field name="priority" eval="90"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">radwan_id_status == 'expired' or radwan_passport_status == 'expired' or radwan_medical_insurance_status == 'expired' or radwan_contract_status == 'expired' or radwan_document_expiry_status == 'expired'</attribute>
                <attribute name="decoration-warning">radwan_id_status == 'expiring_soon' or radwan_passport_status == 'expiring_soon' or radwan_medical_insurance_status == 'expiring_soon' or radwan_contract_status == 'expiring_soon' or radwan_document_expiry_status == 'expiring_soon'</attribute>
            </xpath>

            <xpath expr="//field[@name='radwan_contract_status']" position="after">
                <field name="radwan_document_expiry_name" optional="show"/>
                <field name="radwan_document_expiry_date" optional="show"/>
                <field name="radwan_document_expiry_status"
                       optional="show"
                       widget="badge"
                       decoration-success="radwan_document_expiry_status == 'valid'"
                       decoration-warning="radwan_document_expiry_status == 'expiring_soon'"
                       decoration-danger="radwan_document_expiry_status == 'expired'"
                       decoration-muted="radwan_document_expiry_status == 'not_set'"/>
            </xpath>
        </field>
    </record>

</odoo>
