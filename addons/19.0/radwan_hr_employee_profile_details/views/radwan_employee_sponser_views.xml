<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="radwan_employee_sponser_view_list" model="ir.ui.view">
        <field name="name">radwan.employee.sponser.view.list</field>
        <field name="model">radwan.employee.sponser</field>
        <field name="arch" type="xml">
            <list string="Sponsers" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="SPONSER NAME"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="radwan_employee_sponser_view_form" model="ir.ui.view">
        <field name="name">radwan.employee.sponser.view.form</field>
        <field name="model">radwan.employee.sponser</field>
        <field name="arch" type="xml">
            <form string="Sponser">
                <sheet>
                    <group>
                        <field name="name" string="Sponser Name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="radwan_employee_sponser_action" model="ir.actions.act_window">
        <field name="name">Sponser</field>
        <field name="res_model">radwan.employee.sponser</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="radwan_employee_sponser_menu"
              name="Sponser"
              parent="hr.menu_config_employee"
              action="radwan_employee_sponser_action"
              sequence="85"
              groups="hr.group_hr_manager"/>

</odoo>
