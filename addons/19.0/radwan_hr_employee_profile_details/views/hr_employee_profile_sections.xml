<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_collapsible_sections" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.radwan.collapsible.sections</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="125"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='radwan_hr_information']/details[.//field[@name='radwan_employee_code']]" position="attributes">
                <attribute name="open"/>
            </xpath>
            <xpath expr="//page[@name='radwan_hr_information']/details[.//field[@name='identification_id']]" position="attributes">
                <attribute name="open"/>
            </xpath>
            <xpath expr="//page[@name='radwan_hr_information']/details[.//field[@name='radwan_passport_expiry_date']]" position="attributes">
                <attribute name="open"/>
            </xpath>
            <xpath expr="//page[@name='radwan_hr_information']/details[.//field[@name='radwan_passport_expiry_date']]/div/group" position="replace">
                <group>
                    <group>
                        <field name="passport_id" string="Passport Number"/>
                        <field name="radwan_passport_issue_date"/>
                        <label for="radwan_passport_expiry_date"/>
                        <div class="o_row radwan_expiry_date_status">
                            <field name="radwan_passport_expiry_date" nolabel="1"/>
                            <field name="radwan_passport_status"
                                   readonly="1"
                                   nolabel="1"
                                   widget="badge"
                                   decoration-success="radwan_passport_status == 'valid'"
                                   decoration-warning="radwan_passport_status == 'expiring_soon'"
                                   decoration-danger="radwan_passport_status == 'expired'"
                                   decoration-muted="radwan_passport_status == 'not_set'"/>
                        </div>
                    </group>
                    <group>
                        <field name="radwan_passport_issue_place"/>
                        <field name="radwan_passport_profession"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='radwan_hr_information']/details[.//field[@name='radwan_medical_insurance_end']]" position="attributes">
                <attribute name="open"/>
            </xpath>

            <xpath expr="//page[@name='radwan_hr_information']/details[.//field[@name='radwan_medical_insurance_end']]" position="after">
                <details open="open" style="margin-bottom:12px; border:1px solid #e6e1e5; border-radius:6px; overflow:hidden;">
                    <summary style="background-color:#714B67; color:#ffffff; padding:9px 14px; font-weight:700; cursor:pointer; letter-spacing:.2px;">
                        SOCIAL INSURANCE DATA
                    </summary>
                    <div style="padding:14px 16px 16px 16px; background-color:#ffffff;">
                        <group>
                            <group>
                                <field name="radwan_social_insurance_join_date"/>
                                <field name="radwan_social_insurance_exit_date"/>
                                <field name="radwan_social_insurance_wage"/>
                            </group>
                            <group>
                                <field name="radwan_social_insurance_employee_rate"/>
                                <field name="radwan_social_insurance_company_rate"/>
                                <field name="radwan_social_insurance_profession"/>
                            </group>
                        </group>
                    </div>
                </details>
            </xpath>

            <xpath expr="//page[@name='radwan_hr_information']/details[.//field[@name='radwan_contract_start_date']]" position="replace"/>

        </field>
    </record>

</odoo>
