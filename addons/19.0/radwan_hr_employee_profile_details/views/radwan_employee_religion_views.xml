<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="radwan_employee_religion_view_list" model="ir.ui.view">
        <field name="name">radwan.employee.religion.view.list</field>
        <field name="model">radwan.employee.religion</field>
        <field name="arch" type="xml">
            <list string="Religions" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="RELIGION NAME"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="radwan_employee_religion_view_form" model="ir.ui.view">
        <field name="name">radwan.employee.religion.view.form</field>
        <field name="model">radwan.employee.religion</field>
        <field name="arch" type="xml">
            <form string="Religion">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="radwan_employee_religion_action" model="ir.actions.act_window">
        <field name="name">Religions</field>
        <field name="res_model">radwan.employee.religion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="radwan_employee_religion_menu"
              name="Religions"
              parent="hr.menu_config_employee"
              action="radwan_employee_religion_action"
              sequence="86"
              groups="hr.group_hr_manager"/>

</odoo>
