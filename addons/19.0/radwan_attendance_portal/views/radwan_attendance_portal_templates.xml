<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="radwan_attendance_no_employee" name="Employee Attendance Portal - No Employee">
        <t t-call="website.layout">
            <main class="radwan-attendance-page">
                <section class="container py-5">
                    <div class="radwan-attendance-card p-4 text-center">
                        <h1 class="h4 mb-3">Employee Attendance Portal</h1>
                        <p class="mb-0 text-muted">No employee is linked to your user. Please contact HR.</p>
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="radwan_attendance_portal_page" name="Employee Attendance Portal">
        <t t-call="website.layout">
            <main
                class="radwan-attendance-page"
                t-att-dir="'rtl' if request.env.lang and request.env.lang.startswith('ar') else 'ltr'"
            >
                <section class="container py-3 py-lg-4 radwan_attendance_portal">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-3">
                        <div>
                            <h1 class="h4 mb-1">Employee Attendance Portal</h1>
                            <div class="text-muted small">
                                <span>Today</span>
                                <span class="mx-1">:</span>
                                <span t-out="today"/>
                            </div>
                        </div>
                        <span t-attf-class="radwan-attendance-status radwan-attendance-status-#{employee['status']}">
                            <t t-out="employee['status_label']"/>
                        </span>
                    </div>

                    <div class="radwan-attendance-card p-3 p-lg-4 mb-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <img
                                    class="radwan-attendance-avatar"
                                    t-att-src="employee['image_url']"
                                    alt="Employee"
                                />
                            </div>
                            <div class="col">
                                <h2 class="h5 mb-3" t-out="employee['name']"/>
                                <div class="radwan-employee-info-grid">
                                    <div class="radwan-info-row">
                                        <span class="radwan-info-label">Department</span>
                                        <span class="radwan-info-value" t-out="employee['department'] or '-'"/>
                                    </div>
                                    <div class="radwan-info-row">
                                        <span class="radwan-info-label">Direct Manager</span>
                                        <span class="radwan-info-value" t-out="employee['manager'] or '-'"/>
                                    </div>
                                    <div class="radwan-info-row">
                                        <span class="radwan-info-label">Profession</span>
                                        <span class="radwan-info-value" t-out="employee['job_title'] or '-'"/>
                                    </div>
                                    <div class="radwan-info-row">
                                        <span class="radwan-info-label">Job Position</span>
                                        <span class="radwan-info-value" t-out="employee['job'] or '-'"/>
                                    </div>
                                    <div class="radwan-info-row">
                                        <span class="radwan-info-label">Nationality</span>
                                        <span class="radwan-info-value" t-out="employee['nationality'] or '-'"/>
                                    </div>
                                    <div class="radwan-info-row">
                                        <span class="radwan-info-label">Current Status</span>
                                        <span class="radwan-info-value" t-out="employee['status_label']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="radwan-attendance-card p-3 mb-3">
                        <div class="radwan-attendance-actions">
                            <button type="button" class="btn radwan-btn-check-in" data-radwan-attendance-action="check_in">
                                Check In
                            </button>
                            <button type="button" class="btn radwan-btn-check-out" data-radwan-attendance-action="check_out">
                                Check Out
                            </button>
                            <button type="button" class="btn radwan-btn-permission" data-bs-toggle="modal" data-bs-target="#radwanAttendancePermissionModal">
                                Permission
                            </button>
                        </div>
                        <div class="radwan-attendance-message mt-3 d-none" role="alert"/>
                    </div>

                    <div class="radwan-attendance-card p-0 overflow-hidden">
                        <div class="radwan-card-title px-3 py-2">Today's Log</div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 radwan-attendance-table">
                                <thead>
                                    <tr>
                                        <th>Check In Date</th>
                                        <th>Check In Time</th>
                                        <th>Check In Location</th>
                                        <th>Check Out Date</th>
                                        <th>Check Out Time</th>
                                        <th>Check Out Location</th>
                                        <th>Worked Hours</th>
                                        <th>Status</th>
                                        <th>Approval</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="attendance_rows" t-as="row">
                                        <td t-out="row['check_in_date']"/>
                                        <td t-out="row['check_in_time']"/>
                                        <td>
                                            <a t-if="row['in_maps']" t-att-href="row['in_maps']" target="_blank" rel="noopener">
                                                View Map
                                            </a>
                                            <span t-else="">-</span>
                                        </td>
                                        <td t-out="row['check_out_date'] or '-'"/>
                                        <td t-out="row['check_out_time'] or '-'"/>
                                        <td>
                                            <a t-if="row['out_maps']" t-att-href="row['out_maps']" target="_blank" rel="noopener">
                                                View Map
                                            </a>
                                            <span t-else="">-</span>
                                        </td>
                                        <td t-out="row['worked_hours']"/>
                                        <td t-out="row['status']"/>
                                        <td t-out="row['approval_status'] or '-'"/>
                                    </tr>
                                    <tr t-if="not attendance_rows">
                                        <td colspan="9" class="text-center text-muted py-4">No attendance records today.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="radwan-attendance-card p-0 overflow-hidden mt-3">
                        <div class="radwan-card-title px-3 py-2">Today's Permissions</div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 radwan-attendance-table radwan-permission-table">
                                <thead>
                                    <tr>
                                        <th>Request Date</th>
                                        <th>Permission Type</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="permission_rows" t-as="permission">
                                        <td t-out="permission['request_date']"/>
                                        <td t-out="permission['permission_type']"/>
                                        <td t-out="permission['time_from']"/>
                                        <td t-out="permission['time_to']"/>
                                        <td t-out="permission['reason']"/>
                                        <td>
                                            <span t-attf-class="radwan-permission-badge radwan-permission-badge-#{permission['state_class']}">
                                                <t t-out="permission['state_label']"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr t-if="not permission_rows">
                                        <td colspan="6" class="text-center text-muted py-4">No permission requests today.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="modal fade" id="radwanAttendanceCameraModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h2 class="modal-title h5">Attendance Photo</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body">
                                    <p class="radwan-attendance-camera-message small text-muted mb-3">
                                        Please capture an attendance photo before continuing.
                                    </p>
                                    <video class="radwan-attendance-camera-video" playsinline="playsinline" autoplay="autoplay"/>
                                    <canvas class="radwan-attendance-camera-canvas d-none"/>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-radwan-camera-cancel="1" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" class="btn btn-primary" data-radwan-camera-capture="1">Capture Photo</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="radwanAttendancePermissionModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form class="modal-content radwan-attendance-permission-form">
                                <div class="modal-header">
                                    <h2 class="modal-title h5">Permission Request</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label" for="radwan_permission_type">Permission Type</label>
                                        <select class="form-select" id="radwan_permission_type" name="permission_type" required="required">
                                            <option t-foreach="permission_types" t-as="permission_type" t-att-value="permission_type[0]">
                                                <t t-out="permission_type[1]"/>
                                            </option>
                                        </select>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-12 col-sm-6 mb-3">
                                            <label class="form-label" for="radwan_time_from">From</label>
                                            <input class="form-control" id="radwan_time_from" name="time_from" type="time" required="required"/>
                                        </div>
                                        <div class="col-12 col-sm-6 mb-3">
                                            <label class="form-label" for="radwan_time_to">To</label>
                                            <input class="form-control" id="radwan_time_to" name="time_to" type="time" required="required"/>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="radwan_reason">Reason</label>
                                        <input class="form-control" id="radwan_reason" name="reason" required="required"/>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label" for="radwan_note">Notes</label>
                                        <textarea class="form-control" id="radwan_note" name="note" rows="3"/>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn radwan-btn-permission">Submit Request</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="radwan_attendance_portal_home_entry" inherit_id="portal.portal_my_home" name="Attendance Portal Home Entry">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Employee Attendance</t>
                <t t-set="text">Track daily check in, check out, and permissions</t>
                <t t-set="url" t-value="'/my/attendance'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="radwan_attendance_location_map_picker" name="Attendance Location Map Picker">
        <t t-call="website.layout">
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
            <main
                class="radwan-location-picker-page"
                t-att-dir="'rtl' if request.env.lang and request.env.lang.startswith('ar') else 'ltr'"
            >
                <section
                    class="container py-3 py-lg-4 radwan_attendance_location_picker"
                    t-att-data-location-id="location.id"
                >
                    <div class="radwan-attendance-card p-3 p-lg-4">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-3">
                            <div>
                                <h1 class="h4 mb-1">Select Attendance Location</h1>
                                <div class="text-muted" t-out="location.name"/>
                            </div>
                            <a class="btn btn-light" t-att-href="location.google_maps_url" target="_blank" rel="noopener">
                                View on Google Maps
                            </a>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-lg-8">
                                <div class="radwan-location-map"/>
                            </div>
                            <div class="col-12 col-lg-4">
                                <div class="mb-3">
                                    <label class="form-label" for="radwan_location_latitude">Latitude</label>
                                    <input
                                        class="form-control"
                                        id="radwan_location_latitude"
                                        name="latitude"
                                        t-att-value="location.latitude"
                                    />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="radwan_location_longitude">Longitude</label>
                                    <input
                                        class="form-control"
                                        id="radwan_location_longitude"
                                        name="longitude"
                                        t-att-value="location.longitude"
                                    />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="radwan_location_radius">Allowed Radius (m)</label>
                                    <input
                                        class="form-control"
                                        id="radwan_location_radius"
                                        name="allowed_radius"
                                        type="number"
                                        min="10"
                                        step="5"
                                        t-att-value="location.allowed_radius"
                                    />
                                </div>
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-light" data-radwan-map-current="1">
                                        Use My Current Location
                                    </button>
                                    <button type="button" class="btn btn-primary" data-radwan-map-save="1">
                                        Save Location
                                    </button>
                                </div>
                                <div class="radwan-map-picker-message mt-3 d-none" role="alert"/>
                            </div>
                        </div>
                    </div>
                </section>
            </main>
        </t>
    </template>
</odoo>
