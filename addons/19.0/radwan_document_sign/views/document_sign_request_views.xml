<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="radwan_document_sign_request_sequence" model="ir.sequence">
        <field name="name">Document Signature Request</field>
        <field name="code">radwan.document.sign.request</field>
        <field name="prefix">SIGN/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="view_radwan_document_sign_request_list" model="ir.ui.view">
        <field name="name">radwan.document.sign.request.list</field>
        <field name="model">radwan.document.sign.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_id"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="requester_id"/>
                <field name="sent_date"/>
                <field name="signed_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_radwan_document_sign_request_form" model="ir.ui.view">
        <field name="name">radwan.document.sign.request.form</field>
        <field name="model">radwan.document.sign.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare_fields" string="Prepare Fields" type="object" class="btn-secondary" invisible="state == 'signed'"/>
                    <button name="action_send" string="Send" type="object" class="btn-primary" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_open_portal" string="Open Signing Page" type="object" invisible="not access_url"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('signed', 'cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="document_id"/>
                            <field name="attachment_id" readonly="1"/>
                            <field name="requester_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Signer">
                            <field name="partner_id"/>
                            <field name="employee_id"/>
                            <field name="signer_name" invisible="state != 'signed'"/>
                            <field name="signer_email" invisible="state != 'signed'"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="subject"/>
                        <field name="message" placeholder="Optional message for the signer."/>
                        <field name="access_url" readonly="1" widget="url"/>
                    </group>
                    <group string="Signature" invisible="state != 'signed'">
                        <group>
                            <field name="signed_date"/>
                            <field name="signer_ip"/>
                        </group>
                        <group>
                            <field name="signature_image" widget="image" filename="signature_filename"/>
                            <field name="signature_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signing Fields">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_type"/>
                                    <field name="label"/>
                                    <field name="required"/>
                                    <field name="page"/>
                                    <field name="pos_x"/>
                                    <field name="pos_y"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="signed_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_radwan_document_sign_request_search" model="ir.ui.view">
        <field name="name">radwan.document.sign.request.search</field>
        <field name="model">radwan.document.sign.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_id"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <filter name="waiting" string="Waiting Signature" domain="[('state', '=', 'sent')]"/>
                <filter name="signed" string="Signed" domain="[('state', '=', 'signed')]"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_signer" string="Signer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_radwan_document_sign_requests" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">radwan.document.sign.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_radwan_document_sign_request_search"/>
    </record>

    <menuitem
        id="menu_radwan_document_sign_requests"
        name="Signature Requests"
        action="action_radwan_document_sign_requests"
        sequence="80"
        groups="document_management_system.group_document_user,document_management_system.group_document_manager"
    />

    <template id="mail_signature_request_body">
        <div>
            <p>Hello <t t-out="request.partner_id.name"/>,</p>
            <p>You have been asked to electronically sign the document:</p>
            <p><strong t-out="request.document_id.display_name"/></p>
            <p t-if="request.message" t-out="request.message"/>
            <p>
                <a t-att-href="request.access_url" style="background:#0b5e93;color:#fff;padding:10px 16px;border-radius:6px;text-decoration:none;">
                    Open signing page
                </a>
            </p>
        </div>
    </template>
</odoo>
