<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sign_page" name="Radwan Document Signature Page">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Electronic Signature</title>
                <style>
                    * { box-sizing: border-box; }
                    body {
                        margin: 0;
                        min-height: 100vh;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
                        background: #eef5fa;
                        color: #172331;
                    }
                    .rw-page {
                        width: min(920px, calc(100% - 28px));
                        margin: 32px auto;
                    }
                    .rw-card {
                        border: 1px solid #d9e5ef;
                        border-radius: 14px;
                        box-shadow: 0 16px 42px rgba(15, 46, 71, 0.10);
                        overflow: hidden;
                        background: #fff;
                    }
                    .rw-header {
                        background: linear-gradient(135deg, #003756, #0b82bd);
                        color: #fff;
                        padding: 24px;
                    }
                    .rw-header h1 {
                        margin: 0 0 8px;
                        font-size: 28px;
                        line-height: 1.2;
                    }
                    .rw-document {
                        opacity: 0.92;
                    }
                    .rw-body {
                        padding: 24px;
                    }
                    .rw-muted {
                        color: #607487;
                        font-size: 15px;
                    }
                    .rw-alert {
                        padding: 14px 16px;
                        border-radius: 10px;
                        margin-bottom: 18px;
                    }
                    .rw-alert-danger {
                        background: #fff0f0;
                        border: 1px solid #ffd1d1;
                        color: #8a1f1f;
                    }
                    .rw-alert-success {
                        background: #ecfdf4;
                        border: 1px solid #bcefd2;
                        color: #075b33;
                    }
                    .rw-alert-warning {
                        background: #fff8e6;
                        border: 1px solid #f4d89a;
                        color: #6a4a00;
                    }
                    .rw-grid {
                        display: grid;
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                        gap: 14px;
                        margin: 18px 0;
                    }
                    .rw-field label {
                        display: block;
                        font-size: 14px;
                        font-weight: 700;
                        margin-bottom: 7px;
                    }
                    .rw-field input {
                        width: 100%;
                        border: 1px solid #cfdbe6;
                        border-radius: 10px;
                        padding: 11px 12px;
                        font-size: 16px;
                    }
                    .rw-sign-pad {
                        width: 100%;
                        height: 230px;
                        border: 1px dashed #8bb9d6;
                        border-radius: 12px;
                        background: #f8fbfd;
                        touch-action: none;
                        display: block;
                    }
                    .rw-actions {
                        display: flex;
                        gap: 12px;
                        flex-wrap: wrap;
                        margin-top: 16px;
                    }
                    .rw-btn {
                        border: 0;
                        border-radius: 10px;
                        padding: 11px 18px;
                        font-size: 15px;
                        font-weight: 700;
                        cursor: pointer;
                    }
                    .rw-btn-primary {
                        background: #0b5e93;
                        color: #fff;
                    }
                    .rw-btn-secondary {
                        background: #e7f0f7;
                        color: #174361;
                    }
                    @media (max-width: 640px) {
                        .rw-page { margin: 14px auto; width: calc(100% - 18px); }
                        .rw-header, .rw-body { padding: 18px; }
                        .rw-grid { grid-template-columns: 1fr; }
                        .rw-header h1 { font-size: 24px; }
                    }
                </style>
            </head>
            <body>
                <main class="rw-page">
                    <section class="rw-card">
                        <header class="rw-header">
                            <h1>Electronic Signature</h1>
                            <div class="rw-document" t-out="sign_request.document_id.display_name"/>
                        </header>
                        <div class="rw-body">
                            <t t-if="sign_request.state == 'signed'">
                                <div class="rw-alert rw-alert-success">
                                    This document was signed on
                                    <strong t-out="sign_request.signed_date"/>
                                    by
                                    <strong t-out="sign_request.signer_name or sign_request.partner_id.name"/>.
                                </div>
                            </t>
                            <t t-elif="sign_request.state == 'cancelled'">
                                <div class="rw-alert rw-alert-warning">This signature request has been cancelled.</div>
                            </t>
                            <t t-else="">
                                <p class="rw-muted">Please review the document request and draw your signature below.</p>
                                <t t-if="error">
                                    <div class="rw-alert rw-alert-danger" t-out="error"/>
                                </t>
                                <form t-att-action="'/radwan/sign/%s/submit' % sign_request.token" method="post" id="rw-sign-form">
                                    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                    <input type="hidden" name="signature_data" id="signature_data"/>
                                    <div class="rw-grid">
                                        <div class="rw-field">
                                            <label>Signer Name</label>
                                            <input name="signer_name" t-att-value="sign_request.partner_id.name" required="required"/>
                                        </div>
                                        <div class="rw-field">
                                            <label>Signer Email</label>
                                            <input type="email" name="signer_email" t-att-value="sign_request.partner_id.email"/>
                                        </div>
                                    </div>
                                    <div class="rw-field">
                                        <label>Signature</label>
                                        <canvas id="rw-sign-canvas" class="rw-sign-pad"></canvas>
                                    </div>
                                    <div class="rw-actions">
                                        <button type="button" class="rw-btn rw-btn-secondary" id="rw-clear-signature">Clear</button>
                                        <button type="submit" class="rw-btn rw-btn-primary">Sign Document</button>
                                    </div>
                                </form>
                            </t>
                        </div>
                    </section>
                </main>
                <script>
                    (function () {
                        const canvas = document.getElementById("rw-sign-canvas");
                        if (!canvas) {
                            return;
                        }
                        const clearButton = document.getElementById("rw-clear-signature");
                        const form = document.getElementById("rw-sign-form");
                        const signatureInput = document.getElementById("signature_data");
                        const context = canvas.getContext("2d");
                        let drawing = false;
                        let signed = false;

                        function resizeCanvas() {
                            const ratio = Math.max(window.devicePixelRatio || 1, 1);
                            const rect = canvas.getBoundingClientRect();
                            canvas.width = rect.width * ratio;
                            canvas.height = rect.height * ratio;
                            context.setTransform(ratio, 0, 0, ratio, 0, 0);
                            context.lineCap = "round";
                            context.lineJoin = "round";
                            context.lineWidth = 2.4;
                            context.strokeStyle = "#082f49";
                        }

                        function point(event) {
                            const rect = canvas.getBoundingClientRect();
                            const source = event.touches ? event.touches[0] : event;
                            return {
                                x: source.clientX - rect.left,
                                y: source.clientY - rect.top,
                            };
                        }

                        function start(event) {
                            event.preventDefault();
                            drawing = true;
                            signed = true;
                            const p = point(event);
                            context.beginPath();
                            context.moveTo(p.x, p.y);
                        }

                        function draw(event) {
                            if (!drawing) {
                                return;
                            }
                            event.preventDefault();
                            const p = point(event);
                            context.lineTo(p.x, p.y);
                            context.stroke();
                        }

                        function stop(event) {
                            if (!drawing) {
                                return;
                            }
                            event.preventDefault();
                            drawing = false;
                        }

                        resizeCanvas();
                        window.addEventListener("resize", resizeCanvas);
                        canvas.addEventListener("mousedown", start);
                        canvas.addEventListener("mousemove", draw);
                        canvas.addEventListener("mouseup", stop);
                        canvas.addEventListener("mouseleave", stop);
                        canvas.addEventListener("touchstart", start, { passive: false });
                        canvas.addEventListener("touchmove", draw, { passive: false });
                        canvas.addEventListener("touchend", stop, { passive: false });
                        clearButton.addEventListener("click", function () {
                            context.clearRect(0, 0, canvas.width, canvas.height);
                            signed = false;
                            signatureInput.value = "";
                        });
                        form.addEventListener("submit", function (event) {
                            if (!signed) {
                                event.preventDefault();
                                alert("Please draw your signature first.");
                                return;
                            }
                            signatureInput.value = canvas.toDataURL("image/png");
                        });
                    })();
                </script>
            </body>
        </html>
    </template>

    <template id="portal_sign_success" name="Radwan Document Signature Success">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Signature Saved</title>
                <style>
                    body {
                        margin: 0;
                        min-height: 100vh;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
                        background: #eef5fa;
                        color: #172331;
                        display: grid;
                        place-items: center;
                    }
                    .rw-success {
                        width: min(680px, calc(100% - 28px));
                        background: #fff;
                        border: 1px solid #bcefd2;
                        border-radius: 14px;
                        padding: 28px;
                        box-shadow: 0 16px 42px rgba(15, 46, 71, 0.10);
                    }
                    h1 { margin: 0 0 10px; color: #075b33; }
                    p { margin: 0; color: #475a6b; }
                </style>
            </head>
            <body>
                <section class="rw-success">
                    <h1>Signature saved successfully</h1>
                    <p>Thank you. The document signature was recorded securely.</p>
                </section>
            </body>
        </html>
    </template>
</odoo>
