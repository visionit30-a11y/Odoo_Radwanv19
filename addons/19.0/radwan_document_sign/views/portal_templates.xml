<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sign_layout" name="Radwan Signature Layout">
        <t t-call="portal.frontend_layout">
            <div class="container my-5">
                <t t-out="0"/>
            </div>
        </t>
    </template>

    <template id="portal_sign_page" name="Radwan Document Signature Page">
        <t t-call="radwan_document_sign.portal_sign_layout">
            <style>
                .rw-sign-card {
                    max-width: 860px;
                    margin: 0 auto;
                    border: 1px solid #d9e5ef;
                    border-radius: 14px;
                    box-shadow: 0 16px 42px rgba(15, 46, 71, 0.10);
                    overflow: hidden;
                    background: #fff;
                }
                .rw-sign-header {
                    background: linear-gradient(135deg, #003756, #0b82bd);
                    color: #fff;
                    padding: 24px;
                }
                .rw-sign-body {
                    padding: 24px;
                }
                .rw-sign-pad {
                    width: 100%;
                    height: 220px;
                    border: 1px dashed #8bb9d6;
                    border-radius: 12px;
                    background: #f8fbfd;
                    touch-action: none;
                }
                .rw-sign-actions {
                    display: flex;
                    gap: 12px;
                    flex-wrap: wrap;
                    margin-top: 16px;
                }
                .rw-sign-meta {
                    color: #607487;
                    font-size: 0.95rem;
                }
            </style>
            <div class="rw-sign-card">
                <div class="rw-sign-header">
                    <h2 class="mb-2">Electronic Signature</h2>
                    <div t-out="sign_request.document_id.display_name"/>
                </div>
                <div class="rw-sign-body">
                    <t t-if="sign_request.state == 'signed'">
                        <div class="alert alert-success mb-0">
                            This document was signed on
                            <strong t-out="sign_request.signed_date"/>
                            by
                            <strong t-out="sign_request.signer_name or sign_request.partner_id.name"/>.
                        </div>
                    </t>
                    <t t-elif="sign_request.state == 'cancelled'">
                        <div class="alert alert-warning mb-0">This signature request has been cancelled.</div>
                    </t>
                    <t t-else="">
                        <p class="rw-sign-meta">
                            Please review the document request and draw your signature below.
                        </p>
                        <t t-if="error">
                            <div class="alert alert-danger" t-out="error"/>
                        </t>
                        <form t-att-action="'/radwan/sign/%s/submit' % sign_request.token" method="post" id="rw-sign-form">
                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                            <input type="hidden" name="signature_data" id="signature_data"/>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Signer Name</label>
                                    <input class="form-control" name="signer_name" t-att-value="sign_request.partner_id.name" required="required"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Signer Email</label>
                                    <input class="form-control" type="email" name="signer_email" t-att-value="sign_request.partner_id.email"/>
                                </div>
                            </div>
                            <label class="form-label">Signature</label>
                            <canvas id="rw-sign-canvas" class="rw-sign-pad"></canvas>
                            <div class="rw-sign-actions">
                                <button type="button" class="btn btn-outline-secondary" id="rw-clear-signature">Clear</button>
                                <button type="submit" class="btn btn-primary">Sign Document</button>
                            </div>
                        </form>
                        <script>
                            (function () {
                                const canvas = document.getElementById("rw-sign-canvas");
                                const clearButton = document.getElementById("rw-clear-signature");
                                const form = document.getElementById("rw-sign-form");
                                const signatureInput = document.getElementById("signature_data");
                                const context = canvas.getContext("2d");
                                let drawing = false;
                                let signed = false;

                                function resizeCanvas() {
                                    const ratio = Math.max(window.devicePixelRatio || 1, 1);
                                    const rect = canvas.getBoundingClientRect();
                                    canvas.width = rect.width * ratio;
                                    canvas.height = rect.height * ratio;
                                    context.scale(ratio, ratio);
                                    context.lineCap = "round";
                                    context.lineJoin = "round";
                                    context.lineWidth = 2.4;
                                    context.strokeStyle = "#082f49";
                                }

                                function point(event) {
                                    const rect = canvas.getBoundingClientRect();
                                    const source = event.touches ? event.touches[0] : event;
                                    return {
                                        x: source.clientX - rect.left,
                                        y: source.clientY - rect.top,
                                    };
                                }

                                function start(event) {
                                    event.preventDefault();
                                    drawing = true;
                                    signed = true;
                                    const p = point(event);
                                    context.beginPath();
                                    context.moveTo(p.x, p.y);
                                }

                                function draw(event) {
                                    if (!drawing) {
                                        return;
                                    }
                                    event.preventDefault();
                                    const p = point(event);
                                    context.lineTo(p.x, p.y);
                                    context.stroke();
                                }

                                function stop(event) {
                                    if (!drawing) {
                                        return;
                                    }
                                    event.preventDefault();
                                    drawing = false;
                                }

                                resizeCanvas();
                                window.addEventListener("resize", resizeCanvas);
                                canvas.addEventListener("mousedown", start);
                                canvas.addEventListener("mousemove", draw);
                                canvas.addEventListener("mouseup", stop);
                                canvas.addEventListener("mouseleave", stop);
                                canvas.addEventListener("touchstart", start, { passive: false });
                                canvas.addEventListener("touchmove", draw, { passive: false });
                                canvas.addEventListener("touchend", stop, { passive: false });
                                clearButton.addEventListener("click", function () {
                                    context.clearRect(0, 0, canvas.width, canvas.height);
                                    signed = false;
                                    signatureInput.value = "";
                                });
                                form.addEventListener("submit", function (event) {
                                    if (!signed) {
                                        event.preventDefault();
                                        alert("Please draw your signature first.");
                                        return;
                                    }
                                    signatureInput.value = canvas.toDataURL("image/png");
                                });
                            })();
                        </script>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_sign_success" name="Radwan Document Signature Success">
        <t t-call="radwan_document_sign.portal_sign_layout">
            <div class="mx-auto" style="max-width:720px;">
                <div class="alert alert-success p-4">
                    <h3 class="mb-2">Signature saved successfully</h3>
                    <p class="mb-0">
                        Thank you. The document signature was recorded securely.
                    </p>
                </div>
            </div>
        </t>
    </template>
</odoo>
