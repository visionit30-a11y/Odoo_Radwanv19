<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_ai_employee_names" model="ir.actions.report">
        <field name="name">HR AI Employee Names Report</field>
        <field name="model">radwan.hr.ai.employee.assistant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">radwan_hr_ai_employee.report_hr_ai_employee_names</field>
        <field name="report_file">radwan_hr_ai_employee.report_hr_ai_employee_names</field>
        <field name="print_report_name">'HR AI Employee Names - %s' % (object.create_date or '')</field>
        <field name="binding_model_id" ref="model_radwan_hr_ai_employee_assistant"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hr_ai_employee_names">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="border-bottom:2px solid #0b5e93;padding-bottom:12px;margin-bottom:18px;">
                            <h2 style="margin:0;color:#0b3554;">Employee Names Report</h2>
                            <p style="margin:6px 0 0;color:#64748b;">
                                Generated by HR AI for
                                <strong t-out="doc.user_id.name"/>
                            </p>
                        </div>

                        <t t-set="rows" t-value="doc._employee_report_rows()"/>
                        <div style="margin-bottom:12px;color:#334155;">
                            <strong>Visible employees:</strong>
                            <span t-out="len(rows)"/>
                        </div>

                        <table class="table table-sm" style="width:100%;border-collapse:collapse;font-size:12px;">
                            <thead>
                                <tr style="background:#eaf4fb;color:#0b3554;">
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">#</th>
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">Employee Name</th>
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">Employee No.</th>
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">Department</th>
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">Job Position</th>
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">Manager</th>
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">Work Email</th>
                                    <th style="border:1px solid #cbd5e1;padding:7px;text-align:left;">Mobile</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['index']"/>
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['name']"/>
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['employee_number']"/>
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['department']"/>
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['job']"/>
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['manager']"/>
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['work_email']"/>
                                    <td style="border:1px solid #e2e8f0;padding:6px;" t-out="row['mobile_phone']"/>
                                </tr>
                                <tr t-if="not rows">
                                    <td colspan="8" style="border:1px solid #e2e8f0;padding:12px;text-align:center;color:#64748b;">
                                        No employee records are available under your current HR AI permissions.
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <p style="margin-top:18px;font-size:11px;color:#64748b;">
                            Security note: this report is generated from the same HR AI scope and Odoo record rules available to the current user.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
