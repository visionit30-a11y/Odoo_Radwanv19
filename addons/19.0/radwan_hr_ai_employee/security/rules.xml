<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_ai_employee_assistant_own" model="ir.rule">
        <field name="name">HR AI Assistant: own records</field>
        <field name="model_id" ref="model_radwan_hr_ai_employee_assistant"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_employee_user'))]"/>
    </record>

    <record id="rule_hr_ai_employee_assistant_manager_all" model="ir.rule">
        <field name="name">HR AI Assistant: manager all</field>
        <field name="model_id" ref="model_radwan_hr_ai_employee_assistant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_manager'))]"/>
    </record>

    <record id="rule_hr_ai_employee_message_own" model="ir.rule">
        <field name="name">HR AI Chat Message: own session records</field>
        <field name="model_id" ref="model_radwan_hr_ai_employee_message"/>
        <field name="domain_force">[('assistant_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_employee_user'))]"/>
    </record>

    <record id="rule_hr_ai_employee_message_manager_all" model="ir.rule">
        <field name="name">HR AI Chat Message: manager all</field>
        <field name="model_id" ref="model_radwan_hr_ai_employee_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_manager'))]"/>
    </record>

    <record id="rule_hr_ai_query_log_own" model="ir.rule">
        <field name="name">HR AI Query Log: own records</field>
        <field name="model_id" ref="model_radwan_hr_ai_query_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_employee_user'))]"/>
    </record>

    <record id="rule_hr_ai_query_log_manager_all" model="ir.rule">
        <field name="name">HR AI Query Log: manager all</field>
        <field name="model_id" ref="model_radwan_hr_ai_query_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_manager'))]"/>
    </record>

    <record id="rule_hr_ai_training_approved_user" model="ir.rule">
        <field name="name">HR AI Training: approved active knowledge for users</field>
        <field name="model_id" ref="model_radwan_hr_ai_training_knowledge"/>
        <field name="domain_force">[('active', '=', True), ('state', '=', 'approved')]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_employee_user'))]"/>
    </record>

    <record id="rule_hr_ai_training_trainer_all" model="ir.rule">
        <field name="name">HR AI Training: trainer all knowledge</field>
        <field name="model_id" ref="model_radwan_hr_ai_training_knowledge"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_trainer'))]"/>
    </record>

    <record id="rule_hr_ai_training_history_trainer_all" model="ir.rule">
        <field name="name">HR AI Training History: trainer all</field>
        <field name="model_id" ref="model_radwan_hr_ai_training_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_trainer'))]"/>
    </record>

    <record id="rule_hr_ai_training_example_trainer_all" model="ir.rule">
        <field name="name">HR AI Training Examples: trainer all</field>
        <field name="model_id" ref="model_radwan_hr_ai_training_example"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_trainer'))]"/>
    </record>
</odoo>
