<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_ai_employee_assistant_own" model="ir.rule">
        <field name="name">HR AI Assistant: own records</field>
        <field name="model_id" ref="model_radwan_hr_ai_employee_assistant"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_employee_user'))]"/>
    </record>

    <record id="rule_hr_ai_employee_assistant_manager_all" model="ir.rule">
        <field name="name">HR AI Assistant: manager all</field>
        <field name="model_id" ref="model_radwan_hr_ai_employee_assistant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_manager'))]"/>
    </record>

    <record id="rule_hr_ai_query_log_own" model="ir.rule">
        <field name="name">HR AI Query Log: own records</field>
        <field name="model_id" ref="model_radwan_hr_ai_query_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_employee_user'))]"/>
    </record>

    <record id="rule_hr_ai_query_log_manager_all" model="ir.rule">
        <field name="name">HR AI Query Log: manager all</field>
        <field name="model_id" ref="model_radwan_hr_ai_query_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_ai_manager'))]"/>
    </record>
</odoo>
