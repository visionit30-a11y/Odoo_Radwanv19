<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_ai_data_access_list" model="ir.ui.view">
        <field name="name">radwan.hr.ai.data.access.list</field>
        <field name="model">radwan.hr.ai.data.access</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="model_ids" widget="many2many_tags"/>
                <field name="model_names"/>
                <field name="description"/>
                <field name="allow_all_ai_users"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="group_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_hr_ai_data_access_form" model="ir.ui.view">
        <field name="name">radwan.hr.ai.data.access.form</field>
        <field name="model">radwan.hr.ai.data.access</field>
        <field name="arch" type="xml">
            <form string="HR AI Data Access">
                <header>
                    <button name="action_sync_hr_models" type="object" string="Sync HR Tables" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="model_ids" widget="many2many_tags"/>
                            <field name="model_names" readonly="1"/>
                            <field name="model_descriptions" readonly="1"/>
                            <field name="model_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="allow_all_ai_users"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Short explanation of what this table contains and when AI may use it."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_ai_data_access_search" model="ir.ui.view">
        <field name="name">radwan.hr.ai.data.access.search</field>
        <field name="model">radwan.hr.ai.data.access</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_names"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="all_ai_users" string="All AI Users" domain="[('allow_all_ai_users', '=', True)]"/>
                <filter name="group_model" string="Group by Table" context="{'group_by': 'model_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_ai_data_access" model="ir.actions.act_window">
        <field name="name">AI Data Access</field>
        <field name="res_model">radwan.hr.ai.data.access</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="server_action_sync_hr_ai_data_access" model="ir.actions.server">
        <field name="name">Sync HR AI Tables</field>
        <field name="model_id" ref="model_radwan_hr_ai_data_access"/>
        <field name="binding_model_id" ref="model_radwan_hr_ai_data_access"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_hr_models()</field>
    </record>
</odoo>
