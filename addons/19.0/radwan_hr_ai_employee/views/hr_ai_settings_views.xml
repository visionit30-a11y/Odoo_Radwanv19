<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_ai_res_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hr.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HR AI" string="HR AI" name="radwan_hr_ai" groups="radwan_hr_ai_employee.group_hr_ai_manager">
                    <block title="Open Source AI Connection">
                        <setting string="Provider" help="Use Ollama for local open-source models, or any OpenAI-compatible server.">
                            <field name="radwan_hr_ai_provider"/>
                        </setting>
                        <setting string="Endpoint">
                            <field name="radwan_hr_ai_endpoint" placeholder="http://127.0.0.1:11434"/>
                        </setting>
                        <setting string="Model">
                            <field name="radwan_hr_ai_model" placeholder="qwen2.5:7b-instruct"/>
                        </setting>
                        <setting string="API Key" help="Only required for an OpenAI-compatible provider that needs a key.">
                            <field name="radwan_hr_ai_api_key" password="True"/>
                        </setting>
                        <setting string="Timeout">
                            <field name="radwan_hr_ai_timeout"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_hr_ai_settings" model="ir.actions.act_window">
        <field name="name">HR AI Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context" eval="{'module': 'radwan_hr_ai_employee'}"/>
    </record>
</odoo>
