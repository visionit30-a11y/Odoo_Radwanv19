<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_hr_ai_assistant" name="HR AI Assistant">
        <t t-call="website.layout">
            <main class="container py-4">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-4">
                                <h1 class="h3 mb-2">HR AI Assistant</h1>
                                <p class="text-muted mb-4">Ask about your HR data. Answers are generated using only the records your user can read in Odoo.</p>
                                <form method="post" action="/my/hr-ai">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <label class="form-label" for="question">Question</label>
                                    <textarea id="question" name="question" rows="5" class="form-control" required="required" placeholder="Example: What is my leave balance or latest attendance status?"><t t-out="question"/></textarea>
                                    <button type="submit" class="btn btn-primary mt-3">Ask Assistant</button>
                                </form>
                            </div>
                        </div>
                        <div t-if="answer" class="card shadow-sm border-0 mt-4">
                            <div class="card-body p-4">
                                <h2 class="h5">Answer</h2>
                                <pre class="mb-0 text-wrap" style="white-space: pre-wrap;"><t t-out="answer"/></pre>
                            </div>
                        </div>
                        <div t-if="scope" class="card border-0 bg-light mt-3">
                            <div class="card-body">
                                <h2 class="h6">Security Scope</h2>
                                <pre class="mb-0 text-wrap" style="white-space: pre-wrap;"><t t-out="scope"/></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </t>
    </template>
</odoo>
