<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_ai_employee_assistant_list" model="ir.ui.view">
        <field name="name">radwan.hr.ai.employee.assistant.list</field>
        <field name="model">radwan.hr.ai.employee.assistant</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="question"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_ai_employee_assistant_form" model="ir.ui.view">
        <field name="name">radwan.hr.ai.employee.assistant.form</field>
        <field name="model">radwan.hr.ai.employee.assistant</field>
        <field name="arch" type="xml">
            <form string="Employee HR AI Assistant">
                <header>
                    <button name="action_send_message" type="object" string="Send" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,answered,blocked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Employee HR Assistant</h1>
                    </div>
                    <group string="Session">
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="question" readonly="1" string="Last Question"/>
                        </group>
                    </group>
                    <field name="chat_html" nolabel="1" readonly="1" widget="html"/>
                    <separator string="Ask HR AI"/>
                    <group>
                        <field name="input_text" nolabel="1" placeholder="Type your HR question here..." colspan="4"/>
                    </group>
                    <button name="action_send_message" type="object" string="Send Message" class="btn-primary"/>
                    <notebook>
                        <page string="Last Answer">
                            <field name="answer" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Security Scope">
                            <field name="scope_summary" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_ai_query_log_list" model="ir.ui.view">
        <field name="name">radwan.hr.ai.query.log.list</field>
        <field name="model">radwan.hr.ai.query.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="audience"/>
                <field name="question"/>
                <field name="training_knowledge_ids" widget="many2many_tags"/>
                <field name="is_blocked"/>
            </list>
        </field>
    </record>

    <record id="view_hr_ai_query_log_form" model="ir.ui.view">
        <field name="name">radwan.hr.ai.query.log.form</field>
        <field name="model">radwan.hr.ai.query.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="employee_id"/>
                        <field name="audience"/>
                        <field name="visible_employee_count"/>
                        <field name="allowed_model_names"/>
                        <field name="training_knowledge_ids" widget="many2many_tags"/>
                        <field name="is_blocked"/>
                        <field name="blocked_reason"/>
                    </group>
                    <group>
                        <field name="question"/>
                        <field name="answer"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_ai_employee_assistant" model="ir.actions.act_window">
        <field name="name">Employee AI Assistant</field>
        <field name="res_model">radwan.hr.ai.employee.assistant</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_ai_query_log" model="ir.actions.act_window">
        <field name="name">AI Query Logs</field>
        <field name="res_model">radwan.hr.ai.query.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
